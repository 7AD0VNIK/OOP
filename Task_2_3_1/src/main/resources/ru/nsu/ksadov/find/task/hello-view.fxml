<?import javafx.scene.layout.VBox?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.nsu.ksadov.find.task.Controller"
      onKeyPressed="#handleButtonsPressed"> <Label fx:id="label" text="Score: 0" style="-fx-font-size: 20px;"/>
    <Button text="Restart Game" onAction="#handleRestart" focusTraversable="false" />
    <Canvas fx:id="gameCanvas" width="400" height="400" focusTraversable="true"/>

</VBox>